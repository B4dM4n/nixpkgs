--- a/proxmox-sys/src/fs/file.rs	2026-10-23 12:25:03.215249335 +0200
+++ b/proxmox-sys/src/fs/file.rs	2026-10-23 12:29:35.831917811 +0200
@@ -20,6 +20,46 @@
 
 use crate::fs::CreateOptions;
 
+// glibc provides a renameat2 wrapper, musl does not. On musl use the raw syscall, which
+// returns -errno on failure instead of -1 with errno set, so convert it accordingly.
+#[cfg(not(target_env = "musl"))]
+unsafe fn renameat2_noreplace(
+    oldpath: *const libc::c_char,
+    newpath: *const libc::c_char,
+) -> Result<i32, Errno> {
+    unsafe {
+        Errno::result(libc::renameat2(
+            libc::AT_FDCWD,
+            oldpath,
+            libc::AT_FDCWD,
+            newpath,
+            libc::RENAME_NOREPLACE,
+        ))
+    }
+}
+
+#[cfg(target_env = "musl")]
+unsafe fn renameat2_noreplace(
+    oldpath: *const libc::c_char,
+    newpath: *const libc::c_char,
+) -> Result<i32, Errno> {
+    let res = unsafe {
+        libc::syscall(
+            libc::SYS_renameat2,
+            libc::AT_FDCWD,
+            oldpath,
+            libc::AT_FDCWD,
+            newpath,
+            libc::RENAME_NOREPLACE,
+        )
+    };
+    if res < 0 {
+        Err(Errno::from_raw((-res) as i32))
+    } else {
+        Ok(res as i32)
+    }
+}
+
